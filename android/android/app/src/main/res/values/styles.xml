<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动时的主题：无标题栏、无 ActionBar，避免出现系统原生黑色顶栏。
         注意：不要继承 Theme.Black / Theme.Black.NoTitleBar，这些系统旧主题会
         自带一层不透明的默认状态栏背景（灰色），与 App 内浅色/深色主题无关，
         在 edge-to-edge (Android 15 / targetSdk 35+) 下会表现为顶部一条灰色
         遮挡条，覆盖状态栏文字/图标区域。改为继承 Theme.DeviceDefault.NoActionBar
         并显式声明状态栏透明。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
    <!-- Flutter 首帧渲染后切换到的主题：同样禁用 ActionBar/标题栏，
         顶部标题栏完全由 Flutter 内的 AppBar 绘制，跟随应用内主题切换。
         状态栏/导航栏背景显式设为透明，交由 Flutter 的 edge-to-edge 内容
         自行绘制，避免系统默认灰色背景条。 -->
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
